*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    text-decoration:none;
    border:none;
    outline:none;
    font-family:Arial, sans-serif;
}
html{
    font-size:62.5%;
}
body{
    width:100%;
    min-height:100vh;
    overflow-x:hidden;
    background:black;
    color:white;
}
header{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    padding:2rem 9%;
    display:flex;
    justify-content:space-between;
    align-items:center;
    z-index:100;
    background:black;
}
.logo{
    font-size:3rem;
    color:red;
    font-weight:800;
    cursor:pointer;
    transition:0.3s ease;
}
.logo:hover{
    transform:scale(1.1);
}
nav a{
    font-size:1.8rem;
    color:white;
    margin-left:4rem;
    font-weight:500;
    transition:0.3s ease;
    border-bottom:3px solid transparent;
}
nav a:hover,
nav a.active{
    color:red;
    border-bottom:3px solid red;
}
.home{
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    gap:8rem;
    padding:10rem 9%;
}
.home-img img{
    width:32vw;
    max-width:350px;
    border-radius:50%;
    box-shadow:0 0 25px red;
    cursor:pointer;
    transition:0.3s ease;
    object-fit:cover;
    aspect-ratio:1/1;
}
.home-img img:hover{
    transform:scale(1.05);
}
.home-content h1{
    font-size:6rem;
    font-weight:700;
    line-height:1.3;
}
.home-content h1 span{
    color:red;
}
.home-content h3{
    font-size:4rem;
    margin-bottom:1rem;
}
.home-content p{
    font-size:1.6rem;
    line-height:1.8;
    margin-top:1rem;
}

.typing-text span{
    position:relative;
    color:red;
}
.typing-text span::before{
    content:"Web Developer";
    animation:words 20s infinite;
}
.typing-text span::after{
    content:"";
    position:absolute;
    right:-8px;
    width:3px;
    height:100%;
    background:red;
    animation:blink 0.7s infinite;
}
@keyframes blink{
    50%{
        opacity:0;
    }
}
@keyframes words{
    0%,20%{
        content:"Web Developer";
    }
    21%,40%{
        content:"Software Developer";
    }
    41%,60%{
        content:"Web Designer";
    }
    61%,80%{
        content:"Student";
    }
    81%,100%{
        content:"Gamer";
    }
}
.social-icons a{
    display:inline-flex;
    justify-content:center;
    align-items:center;
    width:4rem;
    height:4rem;
    border:0.2rem solid red;
    border-radius:50%;
    margin:3rem 1.5rem 3rem 0;
    font-size:2rem;
    color:white;
    transition:0.3s ease;
}
.social-icons a:hover{
    background:red;
    color:black;
    transform:scale(1.2);
    box-shadow:0 0 25px red;
}
.btn{
    display:inline-block;
    padding:1rem 2.8rem;
    background:black;
    border:2px solid red;
    border-radius:4rem;
    font-size:1.6rem;
    color:red;
    font-weight:600;
    transition:0.3s ease;
}
.btn:hover{
    background:red;
    color:black;
    box-shadow:0 0 25px red;
}

@media(max-width:995px){
    .home{
        flex-direction:column;
        text-align:center;
        gap:4rem;
    }
    .home-img img{
        width:70vw;
        max-width:300px;
    }
    .home-content h1{
        font-size:5rem;
    }
    .home-content h3{
        font-size:3rem;
    }

    nav{
        display:none;
    }
}
